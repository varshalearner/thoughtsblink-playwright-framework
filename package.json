  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "eslint": "10.15.0",
    "eslint-plugin-playwright": "2.12.2",
    "jiti": "2.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0"
  }
}
