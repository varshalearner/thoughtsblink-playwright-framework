{
  "name": "thoughtsblink-playwright-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test automation framework for ThoughtsBlink Studio",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.22.1"
  },
  "scripts": {
    "test": "playwright test",
    "test:local": "cross-env TEST_ENV=local playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:api": "playwright test --project=api",
    "test:chromium": "playwright test --project=chromium",
    "test:headed": "playwright test --project=chromium --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --project=chromium --debug",
    "har:update": "cross-env UPDATE_HAR=1 playwright test --grep @har --project=chromium && node scripts/scrub-har.mts tests/hars/catalogue.har",
    "report": "playwright show-report",
    "codegen": "playwright codegen https://thoughtsblink.vercel.app",
    "check": "npm run lint && npm run typecheck && npm run format:check",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@faker-js/faker": "10.6.0",
    "@playwright/test": "1.65.1",
    "@types/node": "22.20.5",
    "cross-env": "10.1.0",
    "dotenv": "18.0.10",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-playwright": "2.12.2",
    "husky": "9.1.7",
    "jiti": "2.7.0",
    "lint-staged": "17.6.2",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.73.0",
    "zod": "4.6.7"
  }
}
