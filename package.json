{
  "name": "thoughtsblink-playwright-framework",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright + TypeScript test automation framework for ThoughtsBlink Studio",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "playwright test",
