# Copy to .env (shared) or .env.<TEST_ENV> (per environment) and fill in. Never commit the copies.
# Load order: shell / CI variables, then .env.<TEST_ENV>, then .env. The first value found wins.

# TEST_ENV picks the environment: prod (default) | local.
# Set it in the shell or an npm script, not in these files: it decides which file is loaded.

# Optional: point the selected environment at another URL, e.g. a Vercel preview deployment
# BASE_URL=https://thoughtsblink-git-feature-x.vercel.app

# Supabase project used by the API tests. Both values are public (the browser downloads them):
# copy NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY from the app.
# Never put the service-role key here.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Test accounts, one per role. Create them on the site; the admin also needs
# role = 'admin' in public.profiles. Use dedicated accounts, not personal ones.
BUYER_EMAIL=
BUYER_PASSWORD=
ARTIST_EMAIL=
ARTIST_PASSWORD=
ADMIN_EMAIL=
ADMIN_PASSWORD=
